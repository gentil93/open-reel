{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "open-reel",
	"version": "0.1.0",
	"identifier": "org.openreel.desktop",
	"build": {
		"frontendDist": "../../web/dist",
		"beforeBuildCommand": "bun run prepare-bundle",
		"beforeDevCommand": "bun run prepare-bundle"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Photography",
		"shortDescription": "One interface for many image and video generation models",
		"externalBin": ["binaries/open-reel-server"],
		"resources": {
			"resources/web/": "resources/web/",
			"resources/drizzle/": "resources/drizzle/"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
