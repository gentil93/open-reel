{
	"name": "open-reel",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"build": "bun run --filter '@open-reel/web' --filter '@open-reel/site' build",
		"start": "bun packages/cli/src/index.ts",
		"dev:server": "bun --watch packages/cli/src/index.ts --dev",
		"dev:web": "bun run --filter '@open-reel/web' dev",
		"dev:site": "bun run --filter '@open-reel/site' dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/bun": "latest",
		"typescript": "^5.6.0"
	}
}
